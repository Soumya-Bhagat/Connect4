{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ESNext",

    "rootDir": "./src",
    "outDir": "./dist",

    "types": ["node"],

    "sourceMap": true,

    "strict": true,

    "esModuleInterop": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "moduleDetection": "force",

    "skipLibCheck": true
  }
}